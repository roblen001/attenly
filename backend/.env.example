# Attenly Backend - Default Profile Environment
# Copy this file to `.env` and fill in the values.
#
# This matches the current supported setup:
# Supabase + Gemini + optional Resend.

# =============================================================================
# REQUIRED - Supabase for the default profile
# =============================================================================

APP_PROFILE=default
AUTH_PROVIDER=supabase
DATABASE_PROVIDER=supabase
STORAGE_PROVIDER=supabase
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# REQUIRED - Gemini for the default profile
# =============================================================================

GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# OPTIONAL - Email ingest via Resend
# =============================================================================

# Resend account + inbound webhook signing secret
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Random secret used to authenticate the internal cron endpoint
# Generate with: openssl rand -hex 32
INTERNAL_CRON_SECRET=

# Set these when enabling Resend email ingest:
# OUTBOUND_EMAIL_PROVIDER=resend
# INBOUND_EMAIL_PROVIDER=resend
#
# Backend-supported outbound alternatives:
# OUTBOUND_EMAIL_PROVIDER=none
# OUTBOUND_EMAIL_PROVIDER=microsoft_graph

# =============================================================================
# OPTIONAL - Debug flags
# =============================================================================

# Logs resolved CSS when ingesting custom report templates
DEBUG_TEMPLATE_CSS=false
