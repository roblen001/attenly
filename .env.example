# Attenly Backend Configuration
# Copy this file to .env and fill in your actual values.
#
# This matches the current default profile:
# Supabase + Gemini + optional Resend.
# See .env.default.example for a guided default setup.
# See .env.enterprise.example for the planned enterprise provider profile.

# =============================================================================
# AUTHENTICATION & EXTERNAL SERVICES
# =============================================================================

APP_PROFILE=default
AUTH_PROVIDER=supabase
DATABASE_PROVIDER=supabase
STORAGE_PROVIDER=supabase
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Supabase Configuration (required for the default profile)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Service Configuration (required for the default profile)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional email ingest via Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INTERNAL_CRON_SECRET=
# Set these when enabling Resend email ingest:
# OUTBOUND_EMAIL_PROVIDER=resend
# INBOUND_EMAIL_PROVIDER=resend

# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment Mode
ENV=production
PORT=8080

# CORS Configuration for Production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:8080

# =============================================================================
# OPTIONAL CONFIGURATION (Uses defaults if not set)
# =============================================================================

# LLM Configuration
LLM_MAX_CONTEXT_TOKENS_PER_QUESTION=8000
LLM_TEMPERATURE=0.0

# Vector Search Configuration  
VECTOR_SEARCH_TOP_K_PER_QUESTION=10

# Document Processing Configuration
MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500

# Performance Configuration
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_LLM_REQUESTS=3

# Logging Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false
