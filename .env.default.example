# Attenly Default Profile
# Supported now: Supabase + Gemini + optional Resend.
# Copy to `.env` for the current backend Docker image or local backend server.

# =============================================================================
# REQUIRED - Supabase
# =============================================================================

APP_PROFILE=default
AUTH_PROVIDER=supabase
DATABASE_PROVIDER=supabase
STORAGE_PROVIDER=supabase
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# REQUIRED - Gemini
# =============================================================================

GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Uploaded template ingestion is a harder multimodal/layout task. The default
# profile uses Gemini for this path.
TEMPLATE_INGEST_PROVIDER=gemini
TEMPLATE_INGEST_MODEL_NAME=gemini-3.5-flash

# =============================================================================
# APPLICATION URLS
# =============================================================================

ENV=production
PORT=8080
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# OPTIONAL - Resend email ingest
# =============================================================================

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INTERNAL_CRON_SECRET=
# Set these when enabling Resend email ingest:
# OUTBOUND_EMAIL_PROVIDER=resend
# INBOUND_EMAIL_PROVIDER=resend
# Legacy single-backend deployments can keep email processing inline when an
# external scheduler calls /internal/process-email-jobs.
EMAIL_JOB_EXECUTION_MODE=inline
#
# Backend-supported outbound alternatives:
# OUTBOUND_EMAIL_PROVIDER=none
# OUTBOUND_EMAIL_PROVIDER=microsoft_graph
EMAIL_INGEST_DOMAIN=mail.your-company.com
EMAIL_FROM_DOMAIN=mail.your-company.com
EMAIL_FROM_ADDRESS=noreply@mail.your-company.com

# =============================================================================
# OPTIONAL - Frontend TinyMCE editor
# =============================================================================

# The open-source Docker frontend self-hosts TinyMCE by default. Existing hosted
# deployments that use Tiny Cloud can set cloud mode and a TinyMCE API key in
# the frontend environment.
# VITE_TINYMCE_MODE=cloud
# VITE_TINYMCE_API_KEY=your_tinymce_cloud_api_key
#
# Self-hosted mode requires the TinyMCE assets to be served by the frontend.
# The Docker image includes them at /tinymce/tinymce.min.js.
# VITE_TINYMCE_MODE=self_hosted
# VITE_TINYMCE_SCRIPT_SRC=/tinymce/tinymce.min.js
# VITE_TINYMCE_LICENSE_KEY=gpl

# =============================================================================
# OPTIONAL - Processing and performance tuning
# =============================================================================

DEFAULT_MONTHLY_LIMIT_CAD=15.00
# Used only when a model is not listed in backend pricing. This is useful for
# OpenAI-compatible or local gateways.
DEFAULT_MODEL_INPUT_COST_PER_MILLION_CAD=0.10
DEFAULT_MODEL_OUTPUT_COST_PER_MILLION_CAD=0.40
LLM_MAX_CONTEXT_TOKENS_PER_QUESTION=8000
LLM_TEMPERATURE=0.0
VECTOR_SEARCH_TOP_K_PER_QUESTION=10
MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_LLM_REQUESTS=3
LOG_LEVEL=INFO
DEBUG_MODE=false
