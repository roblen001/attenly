# Non-secret environment used by GitHub Actions Docker smoke tests.
# These values are intentionally fake. Readiness validates configuration,
# database, and filesystem storage without contacting the model endpoint.

ATTENLY_ENV_FILE=.github/env/self-hosted-docker.env
ATTENLY_IMAGE_NAMESPACE=roblen001
ATTENLY_IMAGE_TAG=open-sourcing
ATTENLY_FRONTEND_PORT=5173
ATTENLY_PRECACHE_DOCTR_MODELS=false

ENV=production
PORT=8080
APP_PROFILE=local
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173/api
CORS_ORIGINS=http://localhost:5173

AUTH_PROVIDER=local
LOCAL_AUTH_TOKEN=ci-local-auth-token-32-characters
LOCAL_AUTH_USER_ID=ci-admin
LOCAL_AUTH_EMAIL=ci-admin@example.com
LOCAL_AUTH_DISPLAY_NAME=CI Admin

DATABASE_PROVIDER=sqlalchemy
DATABASE_URL=sqlite:////data/attenly.db
DATABASE_AUTO_CREATE_TABLES=true
STORAGE_PROVIDER=filesystem
STORAGE_PATH=/data/storage

LLM_PROVIDER=openai_compatible
EMBEDDING_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:9/v1
OPENAI_COMPATIBLE_API_KEY=
LLM_MODEL=ci-chat-model
EMBEDDING_MODEL=ci-embedding-model
EMBEDDING_DIMENSIONS=1536

TEMPLATE_INGEST_PROVIDER=disabled
OUTBOUND_EMAIL_PROVIDER=none
INBOUND_EMAIL_PROVIDER=none

VITE_TINYMCE_MODE=self_hosted
VITE_TINYMCE_SCRIPT_SRC=/tinymce/tinymce.min.js
VITE_TINYMCE_LICENSE_KEY=gpl

DEFAULT_MONTHLY_LIMIT_CAD=15.00
DEFAULT_MODEL_INPUT_COST_PER_MILLION_CAD=0
DEFAULT_MODEL_OUTPUT_COST_PER_MILLION_CAD=0
MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500
MAX_CONCURRENT_UPLOADS=2
MAX_CONCURRENT_LLM_REQUESTS=3
LOG_LEVEL=INFO
DEBUG_MODE=false
