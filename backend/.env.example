# Attenly Backend Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# AUTHENTICATION & EXTERNAL SERVICES
# =============================================================================

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Service Configuration (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment Mode
ENV=production
PORT=8080

# CORS Configuration for Production
CORS_ORIGINS=https://app.attently.ca

# Redis Configuration (Required for production)
REDIS_URL=redis://localhost:6379

# =============================================================================
# OPTIONAL CONFIGURATION (Uses defaults if not set)
# =============================================================================

# LLM Configuration
LLM_MAX_CONTEXT_TOKENS_PER_QUESTION=8000
LLM_TEMPERATURE=0.0

# Vector Search Configuration  
VECTOR_SEARCH_TOP_K_PER_QUESTION=10

# Document Processing Configuration
MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500

# =============================================================================
# OCR CONFIGURATION (For image-based PDF processing)
# =============================================================================

# OCR Memory Management (Optimized for 1GB RAM instances)
# These settings prevent Out-of-Memory (OOM) crashes on resource-constrained servers

# Request Queue Settings
# Enable request serialization to prevent concurrent OCR operations from overloading memory
OCR_ENABLE_REQUEST_QUEUE=true
OCR_MAX_CONCURRENT_REQUESTS=1

# Memory Management Settings
# Unload models after each document to free memory (slower but prevents OOM)
OCR_UNLOAD_MODELS_AFTER_USE=true
# Force garbage collection every N pages (1 = most aggressive, higher = less frequent)
OCR_FORCE_GC_FREQUENCY=1

# Processing Limits (Optimized for 1GB RAM)
# Maximum pages per OCR document (30 for 1GB instances, increase for larger hardware)
OCR_MAX_PAGES=30
# Maximum file size in MB
OCR_MAX_FILE_SIZE_MB=60

# OCR Performance Settings (Optimized for 1GB RAM)
# PDF scale factor - lower = less memory but lower quality (1.8 for 1GB, 2.5+ for 2GB+)
OCR_PDF_SCALE=1.8
# Pages to process at once (1 = minimal memory, 3+ = faster but more memory)
OCR_PAGE_CHUNK_SIZE=1
# Recognition batch size (8 for 1GB, 16+ for 2GB+)
OCR_RECO_BATCH_SIZE=8

# OCR Quality Thresholds
OCR_CONFIDENCE_THRESHOLD=0.55
OCR_COVERAGE_THRESHOLD=0.65

# OCR Timeout Settings (in seconds)
OCR_BASE_TIMEOUT=180
OCR_TIMEOUT_PER_50_PAGES=180
OCR_MAX_TIMEOUT=900

# Advanced OCR Settings
# CPU threads for PyTorch (1 for small instances, 2-4 for larger)
OCR_TORCH_NUM_THREADS=1
# Cache directory for model storage
ATTENLY_CACHE_DIR=/cache/attenly/doctr

# =============================================================================
# RECOMMENDED OCR CONFIGURATIONS BY HARDWARE
# =============================================================================

# For 1GB RAM instances (Koyeb free tier):
#   OCR_MAX_PAGES=30
#   OCR_PDF_SCALE=1.8
#   OCR_PAGE_CHUNK_SIZE=1
#   OCR_RECO_BATCH_SIZE=8
#   OCR_ENABLE_REQUEST_QUEUE=true
#   OCR_MAX_CONCURRENT_REQUESTS=1
#   OCR_UNLOAD_MODELS_AFTER_USE=true
#   OCR_FORCE_GC_FREQUENCY=1

# For 2GB+ RAM instances (better performance):
#   OCR_MAX_PAGES=100
#   OCR_PDF_SCALE=2.5
#   OCR_PAGE_CHUNK_SIZE=3
#   OCR_RECO_BATCH_SIZE=16
#   OCR_ENABLE_REQUEST_QUEUE=false
#   OCR_UNLOAD_MODELS_AFTER_USE=false

# Performance Configuration
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_LLM_REQUESTS=3

# Logging Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false
