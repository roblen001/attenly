# Attenly Backend Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# AUTHENTICATION & EXTERNAL SERVICES
# =============================================================================

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Service Configuration (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# EMAIL SERVICE CONFIGURATION (For Email to Attenly Feature)
# =============================================================================

# IMPORTANT: These variables are ONLY required if you want to enable the
# "Email to Attenly" feature. The application will run without them if users
# don't need to forward documents via email.

# Email Provider (Resend) - Required for email feature
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Webhook signing secret from Resend dashboard
# Used to verify inbound email webhooks for security
RESEND_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Internal Authentication - Required for cron endpoints
# Generate a strong random secret (e.g., openssl rand -hex 32)
INTERNAL_CRON_SECRET=your_strong_random_secret_here

# Email Domains Configuration
# Domain for receiving emails (e.g., user aliases like u_abc123@in.attenly.ca)
EMAIL_INGEST_DOMAIN=mail.attenly.ca

# Domain for sending emails (must be verified in Resend)
EMAIL_FROM_DOMAIN=mail.attenly.ca
EMAIL_FROM_ADDRESS=noreply@mail.attenly.ca

# Application URLs (for links in emails)
APP_URL=https://app.attenly.ca
API_URL=https://api.attenly.ca

# Email Feature Limits (Optional - defaults shown)
# Maximum jobs a user can create per 24 hours
EMAIL_RATE_LIMIT_JOBS_PER_DAY=20

# Maximum size per attachment in MB
EMAIL_MAX_ATTACHMENT_SIZE_MB=25

# Maximum total email size in MB (all attachments combined)
EMAIL_MAX_TOTAL_SIZE_MB=50

# Allowed file types (comma-separated, no dots)
EMAIL_ALLOWED_TYPES=pdf,docx,txt,png,jpg,jpeg,gif,webp

# Verification token expiry in hours
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# =============================================================================
# EMAIL SETUP CHECKLIST (Before enabling feature in production)
# =============================================================================
#
# 1. Resend Dashboard Setup:
#    - Add and verify sending domain (mail.attenly.ca)
#      * Add SPF record: v=spf1 include:_spf.resend.com ~all
#      * Add DKIM records (provided by Resend)
#    - Add and verify receiving domain (in.attenly.ca)
#      * Add MX record pointing to Resend's mail servers
#      * Configure catch-all inbound route
#    - Create inbound webhook:
#      * URL: https://api.attenly.ca/webhooks/email-inbound
#      * Enable webhook signing and save the secret
#
# 2. DNS Configuration (Cloudflare or your DNS provider):
#    - Add all records as specified by Resend dashboard
#    - Wait for DNS propagation (can take up to 48 hours)
#    - Verify domain status in Resend shows "Verified"
#
# 3. Koyeb/Production Configuration:
#    - Add all EMAIL_* environment variables to deployment
#    - Set up cron trigger (Koyeb Cron or external service):
#      * URL: https://api.attenly.ca/internal/process-email-jobs
#      * Method: POST
#      * Header: X-Cron-Secret: {INTERNAL_CRON_SECRET}
#      * Schedule: Every 1-2 minutes
#
# 4. Testing:
#    - Enable email ingest in user settings
#    - Add and verify a sender email address
#    - Send test email with attachment to your alias
#    - Verify job processing and report generation
#    - Check notification email delivery
#
# =============================================================================
# SUPABASE STORAGE CONFIGURATION
# =============================================================================

# Supabase Storage bucket for PDF documents (default: report-documents)
STORAGE_BUCKET_NAME=report-documents

# Signed URL expiry time in seconds (default: 3600 = 1 hour)
STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600

# Maximum file size for storage uploads in MB (default: 100)
STORAGE_MAX_FILE_SIZE_MB=100

# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment Mode
ENV=production
PORT=8080

# CORS Configuration for Production
CORS_ORIGINS=https://app.attenly.ca

# Redis Configuration (Required for production)
REDIS_URL=redis://localhost:6379

# =============================================================================
# OPTIONAL CONFIGURATION (Uses defaults if not set)
# =============================================================================

# LLM Configuration
LLM_MAX_CONTEXT_TOKENS_PER_QUESTION=8000
LLM_TEMPERATURE=0.0

# Vector Search Configuration  
VECTOR_SEARCH_TOP_K_PER_QUESTION=10

# Document Processing Configuration
MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500

# =============================================================================
# OCR CONFIGURATION (For image-based PDF processing)
# =============================================================================

# IMPORTANT: Default settings below are optimized for 2GB+ RAM instances.
# For 1GB instances, see configuration examples at the bottom of this section.

# Request Queue Settings
# Disable queue for 2GB+ instances to allow concurrent processing
OCR_ENABLE_REQUEST_QUEUE=false
OCR_MAX_CONCURRENT_REQUESTS=2

# Memory Management Settings  
# Keep models loaded for better performance on 2GB+ instances
OCR_UNLOAD_MODELS_AFTER_USE=false
# Force garbage collection every N chunks (1 = most aggressive)
OCR_FORCE_GC_FREQUENCY=1

# Processing Limits (Optimized for 2GB+ RAM)
# Maximum pages per OCR document
OCR_MAX_PAGES=30
# Maximum file size in MB
OCR_MAX_FILE_SIZE_MB=60

# OCR Performance Settings (Optimized for speed on clean printed documents)
# PDF scale factor - optimized for speed, sufficient for clean text (1.2 for 2GB+, 0.8-1.0 for 1GB)
OCR_PDF_SCALE=1.2
# Pages to process at once - balanced for memory management (3 for 2GB+, 1 for 1GB)
OCR_PAGE_CHUNK_SIZE=3
# Detection batch size - increased for throughput (2 for 2GB+, 1 for 1GB)
OCR_DET_BATCH_SIZE=2
# Recognition batch size - increased for throughput (32 for 2GB+, 8 for 1GB)
OCR_RECO_BATCH_SIZE=32

# OCR Quality Thresholds
OCR_CONFIDENCE_THRESHOLD=0.55
OCR_COVERAGE_THRESHOLD=0.65

# OCR Timeout Settings (in seconds)
OCR_BASE_TIMEOUT=180
OCR_TIMEOUT_PER_50_PAGES=180
OCR_MAX_TIMEOUT=900

# Advanced OCR Settings
# CPU threads for PyTorch (2 for 2-CPU instances like Koyeb, 1 for smaller)
OCR_TORCH_NUM_THREADS=2
# Cache directory for model storage
ATTENLY_CACHE_DIR=/cache/attenly/doctr

# =============================================================================
# RECOMMENDED OCR CONFIGURATIONS BY HARDWARE
# =============================================================================

# PERFORMANCE OPTIMIZATION: The system now loads PDFs once instead of reloading
# for each page chunk, dramatically improving performance (60-80% faster).
# Model optimizations: Using db_mobilenet_v3_large (3-4x faster than db_resnet50)

# For 1GB RAM instances (Koyeb free tier / resource-constrained):
#   OCR_MAX_PAGES=30
#   OCR_PDF_SCALE=0.8
#   OCR_PAGE_CHUNK_SIZE=1
#   OCR_DET_BATCH_SIZE=1
#   OCR_RECO_BATCH_SIZE=8
#   OCR_TORCH_NUM_THREADS=1
#   OCR_ENABLE_REQUEST_QUEUE=true
#   OCR_MAX_CONCURRENT_REQUESTS=1
#   OCR_UNLOAD_MODELS_AFTER_USE=true
#   OCR_FORCE_GC_FREQUENCY=1

# For 2GB+ RAM instances (OPTIMIZED FOR SPEED - DEFAULT):
#   OCR_MAX_PAGES=100
#   OCR_PDF_SCALE=1.2  # Optimized for clean printed text
#   OCR_PAGE_CHUNK_SIZE=3  # Balanced memory management
#   OCR_DET_BATCH_SIZE=2  # Improved throughput
#   OCR_RECO_BATCH_SIZE=32  # High throughput
#   OCR_TORCH_NUM_THREADS=2  # Utilize both CPUs
#   OCR_ENABLE_REQUEST_QUEUE=false
#   OCR_MAX_CONCURRENT_REQUESTS=2
#   OCR_UNLOAD_MODELS_AFTER_USE=false
#   OCR_FORCE_GC_FREQUENCY=1

# Expected Performance (10-page clean printed document):
#   1GB instance: ~150-180 seconds
#   2GB+ instance: ~60-90 seconds (3-5x faster with optimized settings)
#   Note: Performance optimized for clean printed text. Mixed quality may vary.

# Performance Configuration
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_LLM_REQUESTS=3

# Logging Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false
