# Attenly frontend environment
#
# The frontend supports three auth modes:
# - local: default self-hosted mode using a backend bearer token.
# - supabase: hosted profile that matches the original app stack.
# - external_jwt: token login with JWTs issued by your IdP, proxy, or gateway.
#
# Frontend `VITE_` values are bundled into browser code. Do not treat them as
# secrets. Local access tokens must be entered on the login screen and must
# never be placed in a `VITE_` variable.

# =============================================================================
# AUTH - local self-hosted profile
# =============================================================================

VITE_AUTH_PROVIDER=local
VITE_LOCAL_AUTH_USER_ID=local-admin
VITE_LOCAL_AUTH_EMAIL=local-admin@example.com
VITE_LOCAL_AUTH_DISPLAY_NAME=Local Admin

# =============================================================================
# AUTH - Supabase profile
# =============================================================================

# VITE_AUTH_PROVIDER=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# =============================================================================
# AUTH - external JWT profile
# =============================================================================

# VITE_AUTH_PROVIDER=external_jwt
# VITE_LOCAL_AUTH_USER_ID=enterprise-user
# VITE_LOCAL_AUTH_EMAIL=user@company.com
# VITE_LOCAL_AUTH_DISPLAY_NAME=Enterprise User

# =============================================================================
# OPTIONAL - TinyMCE (rich text editor for custom agent templates)
# =============================================================================

# Current hosted deployments can use Tiny Cloud.
VITE_TINYMCE_MODE=cloud
VITE_TINYMCE_API_KEY=

# Open-source Docker deployments self-host TinyMCE and do not need a Tiny Cloud
# API key. The frontend image serves the editor assets from /tinymce.
# VITE_TINYMCE_MODE=self_hosted
# VITE_TINYMCE_SCRIPT_SRC=/tinymce/tinymce.min.js
# VITE_TINYMCE_LICENSE_KEY=gpl

# =============================================================================
# OPTIONAL - API URL (defaults to http://127.0.0.1:8000 in dev)
# =============================================================================

# VITE_API_BASE_URL=http://127.0.0.1:8000
