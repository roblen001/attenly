# Attenly Backend - Local Development Environment
# Copy this file to `.env` and fill in the values.
#
# Ask a maintainer for the dev API keys — do NOT commit real values.

# =============================================================================
# REQUIRED - Supabase (all 4 values come from the Supabase project settings)
# =============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# REQUIRED - Gemini (AI extraction)
# =============================================================================

GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# OPTIONAL - Email-to-Attenly feature (only needed if testing email ingest)
# =============================================================================

# Resend account + inbound webhook signing secret
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_WEBHOOK_SECRET=your_resend_webhook_signing_secret_here

# Random secret used to authenticate the internal cron endpoint
# Generate with: openssl rand -hex 32
INTERNAL_CRON_SECRET=your_strong_random_secret_here

# =============================================================================
# OPTIONAL - Debug flags
# =============================================================================

# Logs resolved CSS when ingesting custom report templates
DEBUG_TEMPLATE_CSS=false
