    "slug": "loss-history-template",
    "name": "Loss-History Snapshot",
    "description": "Extract and present historical loss data for renewal evaluation",
    "reportTemplate": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Business Loss Run Summary</title>\n  <style>\n    /* PDF Page Setup - Landscape orientation for wide tables */\n    @page {\n      size: A4 landscape;\n      margin: 0.5in;\n    }\n    \n    /* Print-specific styles */\n    @media print {\n      body {\n        margin: 0;\n        padding: 0.5in;\n        font-size: 10pt;\n      }\n      .header h1 {\n        font-size: 18pt;\n      }\n      .section-title {\n        font-size: 14pt;\n        page-break-after: avoid;\n      }\n      table {\n        page-break-inside: avoid;\n        font-size: 9pt;\n      }\n      th, td {\n        padding: 4px 6px;\n      }\n    }\n    \n    body {\n      font-family: Arial, sans-serif;\n      color: #333;\n      margin: 0.5in;\n      line-height: 1.3;\n      font-size: 11pt;\n    }\n    \n    .header {\n      text-align: left;\n      margin-bottom: 20px;\n    }\n    \n    .header h1 {\n      margin: 0;\n      font-size: 20px;\n    }\n    \n    .header .meta {\n      margin-top: 8px;\n      font-size: 12px;\n      line-height: 1.4;\n    }\n    \n    .section-title {\n      font-size: 16px;\n      margin-top: 25px;\n      margin-bottom: 10px;\n      text-decoration: underline;\n      page-break-after: avoid;\n    }\n    \n    /* Optimized table styling for PDF */\n    table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-bottom: 20px;\n      table-layout: fixed;\n      font-size: 10px;\n    }\n    \n    table, th, td {\n      border: 1px solid #666;\n    }\n    \n    th, td {\n      padding: 4px 6px;\n      text-align: left;\n      word-wrap: break-word;\n      overflow: hidden;\n    }\n    \n    th {\n      background-color: #f2f2f2;\n      font-weight: bold;\n      font-size: 9px;\n      text-align: center;\n    }\n    \n    /* Policy Term Summary Table - Optimized column widths */\n    .policy-term-table th:nth-child(1),\n    .policy-term-table td:nth-child(1) { width: 12%; } /* Policy Term */\n    .policy-term-table th:nth-child(2),\n    .policy-term-table td:nth-child(2) { width: 10%; } /* Policy Type */\n    .policy-term-table th:nth-child(3),\n    .policy-term-table td:nth-child(3) { width: 8%; }  /* No. of Claims */\n    .policy-term-table th:nth-child(4),\n    .policy-term-table td:nth-child(4) { width: 12%; } /* L&E Reserves */\n    .policy-term-table th:nth-child(5),\n    .policy-term-table td:nth-child(5) { width: 10%; } /* Losses Paid */\n    .policy-term-table th:nth-child(6),\n    .policy-term-table td:nth-child(6) { width: 10%; } /* Expenses Paid */\n    .policy-term-table th:nth-child(7),\n    .policy-term-table td:nth-child(7) { width: 12%; } /* L&E Paid */\n    .policy-term-table th:nth-child(8),\n    .policy-term-table td:nth-child(8) { width: 8%; }  /* Recovery */\n    .policy-term-table th:nth-child(9),\n    .policy-term-table td:nth-child(9) { width: 10%; } /* Total Incurred */\n    \n    /* Claim Details Table - Optimized column widths */\n    .claim-details-table th:nth-child(1),\n    .claim-details-table td:nth-child(1) { width: 12%; } /* Claim # */\n    .claim-details-table th:nth-child(2),\n    .claim-details-table td:nth-child(2) { width: 9%; }  /* Loss Date */\n    .claim-details-table th:nth-child(3),\n    .claim-details-table td:nth-child(3) { width: 9%; }  /* Reported Date */\n    .claim-details-table th:nth-child(4),\n    .claim-details-table td:nth-child(4) { width: 9%; }  /* Close Date */\n    .claim-details-table th:nth-child(5),\n    .claim-details-table td:nth-child(5) { width: 12%; } /* Location */\n    .claim-details-table th:nth-child(6),\n    .claim-details-table td:nth-child(6) { width: 20%; } /* Description */\n    .claim-details-table th:nth-child(7),\n    .claim-details-table td:nth-child(7) { width: 8%; }  /* Status */\n    .claim-details-table th:nth-child(8),\n    .claim-details-table td:nth-child(8) { width: 9%; }  /* Paid Loss */\n    .claim-details-table th:nth-child(9),\n    .claim-details-table td:nth-child(9) { width: 8%; }  /* Reserve */\n    .claim-details-table th:nth-child(10),\n    .claim-details-table td:nth-child(10) { width: 9%; } /* Total Incurred */\n    \n    /* Numeric columns - right align and no wrap */\n    .policy-term-table td:nth-child(3),\n    .policy-term-table td:nth-child(4),\n    .policy-term-table td:nth-child(5),\n    .policy-term-table td:nth-child(6),\n    .policy-term-table td:nth-child(7),\n    .policy-term-table td:nth-child(8),\n    .policy-term-table td:nth-child(9),\n    .claim-details-table td:nth-child(8),\n    .claim-details-table td:nth-child(9),\n    .claim-details-table td:nth-child(10) {\n      text-align: right;\n      white-space: nowrap;\n    }\n    \n    /* Description column - allow text wrapping */\n    .claim-details-table td:nth-child(6) {\n      word-wrap: break-word;\n      white-space: normal;\n    }\n    \n    .summary-metrics {\n      font-weight: bold;\n      margin-bottom: 30px;\n      font-size: 11px;\n      line-height: 1.5;\n    }\n    \n    .footer-note {\n      font-size: 10px;\n      color: #555;\n      margin-top: 30px;\n      border-top: 1px solid #ddd;\n      padding-top: 10px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>Business Loss Run Summary</h1>\n    <div class=\"meta\">\n      <div><strong>Agency Name:</strong> {{BrokerAgent}}</div>\n      <div><strong>Current As of Date:</strong> {{CurrentAsOfDate}}</div>\n      <div><strong>Insured Name:</strong> {{InsuredName}}</div>\n      <div><strong>Policy Number:</strong> {{PolicyNumber}}</div>\n      <div><strong>Coverage Line:</strong> {{CoverageLine}}</div>\n      <div><strong>Policy Period:</strong> {{PolicyPeriod}}</div>\n    </div>\n  </div>\n\n  <div class=\"section-title\">Summary by Policy Term</div>\n  <table class=\"policy-term-table\">\n    <thead>\n      <tr>\n        <th>Policy Term</th>\n        <th>Policy Type</th>\n        <th>No. of Claims</th>\n        <th>L&amp;E Reserves</th>\n        <th>Losses Paid</th>\n        <th>Expenses Paid</th>\n        <th>L&amp;E Paid</th>\n        <th>Recovery</th>\n        <th>Total Incurred</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>{{PolicyTerm}}</td>\n        <td>{{PolicyType}}</td>\n        <td>{{TermClaimsCount}}</td>\n        <td>{{LossExpenseReserves}}</td>\n        <td>{{LossesPaid}}</td>\n        <td>{{ExpensesPaid}}</td>\n        <td>{{LossesExpensesPaid}}</td>\n        <td>{{Recovery}}</td>\n        <td>{{TermTotalIncurred}}</td>\n      </tr>\n    </tbody>\n    <tfoot>\n      <tr>\n        <th colspan=\"2\">Totals</th>\n        <th>{{TotalClaims}}</th>\n        <th>{{TotalReserves}}</th>\n        <th>{{TotalPaid}}</th>\n        <th>{{ExpensesPaid}}</th>\n        <th>{{LossesExpensesPaid}}</th>\n        <th>{{Recovery}}</th>\n        <th>{{TotalIncurred}}</th>\n      </tr>\n    </tfoot>\n  </table>\n\n  <div class=\"section-title\">Claim Details</div>\n  <table class=\"claim-details-table\">\n    <thead>\n      <tr>\n        <th>Claim #</th>\n        <th>Loss Date</th>\n        <th>Reported Date</th>\n        <th>Close Date</th>\n        <th>Location</th>\n        <th>Description</th>\n        <th>Status</th>\n        <th>Paid Loss</th>\n        <th>Reserve</th>\n        <th>Total Incurred</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>{{ClaimNumber}}</td>\n        <td>{{LossDate}}</td>\n        <td>{{ReportedDate}}</td>\n        <td>{{CloseDate}}</td>\n        <td>{{LossLocation}}</td>\n        <td>{{ClaimDescription}}</td>\n        <td>{{ClaimStatus}}</td>\n        <td>{{PaidLoss}}</td>\n        <td>{{ReserveAmount}}</td>\n        <td>{{TotalIncurred}}</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <div class=\"summary-metrics\">\n    <div>Total Number of Claims: <strong>{{TotalClaims}}</strong></div>\n    <div>Total Paid Losses: <strong>{{TotalPaid}}</strong></div>\n    <div>Total Reserves: <strong>{{TotalReserves}}</strong></div>\n    <div>Total Incurred: <strong>{{TotalIncurred}}</strong></div>\n    <div>Open Claims: <strong>{{OpenClaims}}</strong></div>\n  </div>\n\n  <div class=\"footer-note\">\n    <p><em>Important Notice:</em> This information is provided \"as is\" and has not been audited. Please verify all figures before use.</p>\n  </div>\n</body>\n</html>",
