# Attenly Enterprise Profile
# Planned target profile for provider-interface work.
# This file documents the intended configuration for companies that want to
# replace the default Supabase/Gemini/Resend stack with internal services.
#
# NOTE: The backend now supports local bearer-token auth, SQLAlchemy/SQLite,
# filesystem storage, disabled outbound email, and Microsoft Graph outbound
# email. The full enterprise profile still needs OpenAI-compatible LLM,
# embedding, Microsoft Graph inbound, and frontend-auth adapter work before it
# can run end-to-end.

# =============================================================================
# CORE APP
# =============================================================================

ENV=production
PORT=8080
APP_PROFILE=enterprise
APP_URL=https://attenly.company.internal
API_URL=https://attenly-api.company.internal
CORS_ORIGINS=https://attenly.company.internal
APP_SECRET_KEY=replace-with-a-long-random-secret

# =============================================================================
# DATABASE - SQLite through SQLAlchemy for pilots
# =============================================================================

DATABASE_PROVIDER=sqlalchemy
DATABASE_URL=sqlite:////data/attenly.db

# For production, move to a managed SQL database when ready:
# DATABASE_URL=postgresql://attenly:password@postgres.company.internal:5432/attenly

# =============================================================================
# STORAGE - local filesystem volume for pilots
# =============================================================================

STORAGE_PROVIDER=filesystem
STORAGE_PATH=/data/storage

# =============================================================================
# AUTH - local first, SSO later
# =============================================================================

AUTH_PROVIDER=local
LOCAL_AUTH_TOKEN=replace-with-a-long-random-internal-token
LOCAL_AUTH_USER_ID=insurance-company-admin
LOCAL_AUTH_EMAIL=attenly-admin@company.com
LOCAL_AUTH_DISPLAY_NAME=Attenly Admin

# Future SSO example:
# AUTH_PROVIDER=oidc
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://attenly.company.internal/auth/callback

# =============================================================================
# AI - on-prem OpenAI-compatible model endpoint
# =============================================================================

LLM_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=https://models.company.internal/v1
OPENAI_COMPATIBLE_API_KEY=replace-with-internal-model-token
LLM_MODEL=company-document-model

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=company-embedding-model

# =============================================================================
# EMAIL - Microsoft Graph outbound, inbound disabled by default
# =============================================================================

OUTBOUND_EMAIL_PROVIDER=microsoft_graph
INBOUND_EMAIL_PROVIDER=none
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
GRAPH_MAILBOX=attenly@company.com

# To disable all outbound email as well:
# OUTBOUND_EMAIL_PROVIDER=none

# Microsoft Graph inbound email ingestion is planned, not implemented yet.
# INBOUND_EMAIL_PROVIDER=microsoft_graph

# =============================================================================
# OPTIONAL - Processing and performance tuning
# =============================================================================

MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_LLM_REQUESTS=3
LOG_LEVEL=INFO
DEBUG_MODE=false
