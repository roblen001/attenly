# Attenly Backend Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# AUTHENTICATION & EXTERNAL SERVICES
# =============================================================================

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Service Configuration (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# SUPABASE STORAGE CONFIGURATION
# =============================================================================

# Supabase Storage bucket for PDF documents (default: report-documents)
STORAGE_BUCKET_NAME=report-documents

# Signed URL expiry time in seconds (default: 3600 = 1 hour)
STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600

# Maximum file size for storage uploads in MB (default: 100)
STORAGE_MAX_FILE_SIZE_MB=100

# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment Mode
ENV=production
PORT=8080

# CORS Configuration for Production
CORS_ORIGINS=https://app.attently.ca

# Redis Configuration (Required for production)
REDIS_URL=redis://localhost:6379

# =============================================================================
# OPTIONAL CONFIGURATION (Uses defaults if not set)
# =============================================================================

# LLM Configuration
LLM_MAX_CONTEXT_TOKENS_PER_QUESTION=8000
LLM_TEMPERATURE=0.0

# Vector Search Configuration  
VECTOR_SEARCH_TOP_K_PER_QUESTION=10

# Document Processing Configuration
MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500

# =============================================================================
# OCR CONFIGURATION (For image-based PDF processing)
# =============================================================================

# IMPORTANT: Default settings below are optimized for 2GB+ RAM instances.
# For 1GB instances, see configuration examples at the bottom of this section.

# Request Queue Settings
# Disable queue for 2GB+ instances to allow concurrent processing
OCR_ENABLE_REQUEST_QUEUE=false
OCR_MAX_CONCURRENT_REQUESTS=2

# Memory Management Settings  
# Keep models loaded for better performance on 2GB+ instances
OCR_UNLOAD_MODELS_AFTER_USE=false
# Force garbage collection every N chunks (1 = most aggressive)
OCR_FORCE_GC_FREQUENCY=1

# Processing Limits (Optimized for 2GB+ RAM)
# Maximum pages per OCR document
OCR_MAX_PAGES=30
# Maximum file size in MB
OCR_MAX_FILE_SIZE_MB=60

# OCR Performance Settings (Optimized for speed on clean printed documents)
# PDF scale factor - optimized for speed, sufficient for clean text (1.2 for 2GB+, 0.8-1.0 for 1GB)
OCR_PDF_SCALE=1.2
# Pages to process at once - balanced for memory management (3 for 2GB+, 1 for 1GB)
OCR_PAGE_CHUNK_SIZE=3
# Detection batch size - increased for throughput (2 for 2GB+, 1 for 1GB)
OCR_DET_BATCH_SIZE=2
# Recognition batch size - increased for throughput (32 for 2GB+, 8 for 1GB)
OCR_RECO_BATCH_SIZE=32

# OCR Quality Thresholds
OCR_CONFIDENCE_THRESHOLD=0.55
OCR_COVERAGE_THRESHOLD=0.65

# OCR Timeout Settings (in seconds)
OCR_BASE_TIMEOUT=180
OCR_TIMEOUT_PER_50_PAGES=180
OCR_MAX_TIMEOUT=900

# Advanced OCR Settings
# CPU threads for PyTorch (2 for 2-CPU instances like Koyeb, 1 for smaller)
OCR_TORCH_NUM_THREADS=2
# Cache directory for model storage
ATTENLY_CACHE_DIR=/cache/attenly/doctr

# =============================================================================
# RECOMMENDED OCR CONFIGURATIONS BY HARDWARE
# =============================================================================

# PERFORMANCE OPTIMIZATION: The system now loads PDFs once instead of reloading
# for each page chunk, dramatically improving performance (60-80% faster).
# Model optimizations: Using db_mobilenet_v3_large (3-4x faster than db_resnet50)

# For 1GB RAM instances (Koyeb free tier / resource-constrained):
#   OCR_MAX_PAGES=30
#   OCR_PDF_SCALE=0.8
#   OCR_PAGE_CHUNK_SIZE=1
#   OCR_DET_BATCH_SIZE=1
#   OCR_RECO_BATCH_SIZE=8
#   OCR_TORCH_NUM_THREADS=1
#   OCR_ENABLE_REQUEST_QUEUE=true
#   OCR_MAX_CONCURRENT_REQUESTS=1
#   OCR_UNLOAD_MODELS_AFTER_USE=true
#   OCR_FORCE_GC_FREQUENCY=1

# For 2GB+ RAM instances (OPTIMIZED FOR SPEED - DEFAULT):
#   OCR_MAX_PAGES=100
#   OCR_PDF_SCALE=1.2  # Optimized for clean printed text
#   OCR_PAGE_CHUNK_SIZE=3  # Balanced memory management
#   OCR_DET_BATCH_SIZE=2  # Improved throughput
#   OCR_RECO_BATCH_SIZE=32  # High throughput
#   OCR_TORCH_NUM_THREADS=2  # Utilize both CPUs
#   OCR_ENABLE_REQUEST_QUEUE=false
#   OCR_MAX_CONCURRENT_REQUESTS=2
#   OCR_UNLOAD_MODELS_AFTER_USE=false
#   OCR_FORCE_GC_FREQUENCY=1

# Expected Performance (10-page clean printed document):
#   1GB instance: ~150-180 seconds
#   2GB+ instance: ~60-90 seconds (3-5x faster with optimized settings)
#   Note: Performance optimized for clean printed text. Mixed quality may vary.

# Performance Configuration
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_LLM_REQUESTS=3

# Logging Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false
