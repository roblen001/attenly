# Attenly Local Backend Profile
# Backend-supported now: local bearer-token auth, SQLite via SQLAlchemy,
# filesystem document storage, Gemini LLM/embeddings, email disabled.
#
# NOTE: The frontend local-auth adapter is still planned. Until it lands, this
# profile is mainly useful for backend/API testing and the next open-source
# integration branches.

# =============================================================================
# CORE APP
# =============================================================================

ENV=production
PORT=8080
APP_PROFILE=local
APP_URL=http://localhost:5173
API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# AUTH - local bearer token
# =============================================================================

AUTH_PROVIDER=local
LOCAL_AUTH_TOKEN=replace-with-a-long-random-local-token
LOCAL_AUTH_USER_ID=local-admin
LOCAL_AUTH_EMAIL=local-admin@example.com
LOCAL_AUTH_DISPLAY_NAME=Local Admin

# =============================================================================
# DATABASE - SQLite through SQLAlchemy
# =============================================================================

DATABASE_PROVIDER=sqlalchemy
DATABASE_URL=sqlite:////data/attenly.db

# =============================================================================
# STORAGE - local filesystem volume
# =============================================================================

STORAGE_PROVIDER=filesystem
STORAGE_PATH=/data/storage

# =============================================================================
# AI - Gemini remains the currently implemented model provider
# =============================================================================

LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# EMAIL - disabled
# =============================================================================

OUTBOUND_EMAIL_PROVIDER=none
INBOUND_EMAIL_PROVIDER=none

# =============================================================================
# OPTIONAL - Processing and performance tuning
# =============================================================================

MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_LLM_REQUESTS=3
LOG_LEVEL=INFO
DEBUG_MODE=false
