    "slug": "account-summary-template",
    "name": "Account Summary Report",
    "description": "Extract and organize key policy information for underwriter review",
    "reportTemplate": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Account Summary Report</title>\n  <style>\n    /* Page setup */\n    @page { size: A4; margin: 1in; }\n    body {\n      font-family: 'Calibri', sans-serif;\n      font-size: 11pt;\n      color: #333;\n      margin: 0;\n      padding: 1in;\n    }\n    /* Header */\n    header {\n      text-align: center;\n      margin-bottom: 18px;\n      background-color: #244785;\n      padding: 10px;\n    }\n    header h1 {\n      font-size: 16pt;\n      margin: 0;\n    }\n    header p {\n      font-size: 10pt;\n      color: #666;\n      margin: 4px 0 0;\n    }\n    /* Section titles */\n    .section {\n      margin-bottom: 18px;\n    }\n    .section-title {\n      font-size: 12pt;\n      font-weight: bold;\n      border-bottom: 1px solid #000;\n      padding-bottom: 4px;\n      margin-bottom: 8px;\n      color: #333;\n    }\n    /* Definition lists for key/value pairs */\n    dl {\n      margin: 0;\n    }\n    dt {\n      font-weight: bold;\n      width: 30%;\n      float: left;\n      clear: left;\n      margin: 0;\n      padding: 2px 0;\n    }\n    dd {\n      margin: 0 0 2px 32%;\n      padding: 2px 0;\n    }\n    /* Tables */\n    table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 10pt;\n      margin-top: 4px;\n    }\n    th, td {\n      border: 1px solid #ccc;\n      padding: 4px 6px;\n      text-align: left;\n    }\n    th {\n      background: #f0f0f0;\n      font-weight: bold;\n    }\n    /* Footer */\n    footer {\n      text-align: center;\n      font-size: 8pt;\n      color: #999;\n      margin-top: 24px;\n    }\n  </style>\n</head>\n<body>\n  <header>\n    <h1 style=\"color: white;\">Account Summary Report</h1>\n    <p style=\"color: white;\">Comprehensive Underwriting Analysis</p>\n    <p style=\"color: white;\">Generated: ${new Date().toLocaleDateString()} &nbsp;|&nbsp; Report ID: ASR-${Date.now().toString().slice(-6)}</p>\n  </header>\n\n  <section class=\"section\">\n    <div class=\"section-title\">Account Header</div>\n    <dl>\n      <dt>Insured Name:</dt><dd>{{InsuredName}}</dd>\n      <dt>Broker / Agent:</dt><dd>{{BrokerAgent}}</dd>\n      <dt>Policy Number:</dt><dd>{{PolicyNumber}}</dd>\n      <dt>Effective Date:</dt><dd>{{EffectiveDate}}</dd>\n      <dt>Expiration Date:</dt><dd>{{ExpirationDate}}</dd>\n      <dt>Lines of Business:</dt><dd>{{LinesOfBusiness}}</dd>\n    </dl>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"section-title\">Company Profile &amp; Operations</div>\n    <dl>\n      <dt>Address:</dt><dd>{{CompanyAddress}}</dd>\n      <dt>Industry Classification:</dt><dd>{{IndustryClassification}}</dd>\n      <dt>Annual Revenue:</dt><dd>{{AnnualRevenue}}</dd>\n      <dt>Annual Payroll:</dt><dd>{{AnnualPayroll}}</dd>\n    </dl>\n    <p><strong>Business Description:</strong><br>{{BusinessDescription}}</p>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"section-title\">Coverage &amp; Limits Overview</div>\n    <table>\n      <thead>\n        <tr>\n          <th>Line</th>\n          <th>Limit</th>\n          <th>Deductible</th>\n          <th>Premium (Est.)</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>{{CoverageLine}}</td>\n          <td>{{CoverageLimit}}</td>\n          <td>{{Deductible}}</td>\n          <td>{{EstimatedPremium}}</td>\n        </tr>\n      </tbody>\n    </table>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"section-title\">Loss History</div>\n    <dl>\n      <dt>Total Claims (5 Years):</dt><dd>{{TotalClaims5Yr}}</dd>\n      <dt>Aggregate Incurred:</dt><dd>{{AggregateIncurred}}</dd>\n      <dt>Open Claims:</dt><dd>{{OpenClaims}}</dd>\n    </dl>\n    <p><strong>Recent Large Claims:</strong><br>{{RecentLargeClaims}}</p>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"section-title\">Risk Survey &amp; Financial Strength</div>\n    <dl>\n      <dt>Property Condition:</dt><dd>{{PropertyCondition}}</dd>\n      <dt>Safety Programs:</dt><dd>{{SafetyPrograms}}</dd>\n      <dt>Current Ratio:</dt><dd>{{CurrentRatio}}</dd>\n      <dt>EBITDA Margin:</dt><dd>{{EbitdaMargin}}</dd>\n      <dt>Risk Grade:</dt><dd>{{OverallRiskGrade}}</dd>\n    </dl>\n    <p><strong>Identified Gaps:</strong><br>{{IdentifiedGaps}}</p>\n    <p><strong>Financial Controls:</strong><br>{{FinancialControls}}</p>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"section-title\">Underwriter's Notes &amp; Recommendations</div>\n    <dl>\n      <dt>Pricing Considerations:</dt><dd>{{PricingConsiderations}}</dd>\n      <dt>Conditions / Endorsements:</dt><dd>{{ConditionsEndorsements}}</dd>\n    </dl>\n  </section>\n</body>\n</html>",
