# Attenly Local Profile
# Supported now: local bearer-token auth, SQLite via SQLAlchemy, filesystem
# document storage, Gemini or OpenAI-compatible LLM/embeddings, email disabled,
# and frontend local token login.

# =============================================================================
# CORE APP
# =============================================================================

ENV=production
PORT=8080
APP_PROFILE=local
APP_URL=http://localhost:5173
API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# AUTH - local bearer token
# =============================================================================

AUTH_PROVIDER=local
LOCAL_AUTH_TOKEN=replace-with-a-long-random-local-token
LOCAL_AUTH_USER_ID=local-admin
LOCAL_AUTH_EMAIL=local-admin@example.com
LOCAL_AUTH_DISPLAY_NAME=Local Admin

# =============================================================================
# DATABASE - SQLite through SQLAlchemy
# =============================================================================

DATABASE_PROVIDER=sqlalchemy
DATABASE_URL=sqlite:////data/attenly.db

# =============================================================================
# STORAGE - local filesystem volume
# =============================================================================

STORAGE_PROVIDER=filesystem
STORAGE_PATH=/data/storage

# =============================================================================
# AI - Gemini default, OpenAI-compatible optional
# =============================================================================

LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# To use an OpenAI-compatible internal endpoint instead:
# LLM_PROVIDER=openai_compatible
# EMBEDDING_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_BASE_URL=https://models.company.internal/v1
# OPENAI_COMPATIBLE_API_KEY can be blank if your internal gateway does not require authentication.
# OPENAI_COMPATIBLE_API_KEY=replace-with-internal-model-token
# LLM_MODEL=company-document-model
# EMBEDDING_MODEL=company-embedding-model
# EMBEDDING_DIMENSIONS=1536

# Uploaded template ingestion is separate from normal report extraction. It is
# a hard layout/multimodal task, so complex DOCX/PDF templates need a smart
# multimodal provider. Leave disabled when users will build templates in-app.
TEMPLATE_INGEST_PROVIDER=disabled
# To use Gemini for smart template ingestion:
# TEMPLATE_INGEST_PROVIDER=gemini
# TEMPLATE_INGEST_MODEL_NAME=gemini-2.5-pro
# To use an OpenAI-compatible endpoint for smart template ingestion:
# TEMPLATE_INGEST_PROVIDER=openai_compatible
# TEMPLATE_INGEST_MODEL=company-template-model
# Default: send the original upload to /responses as input_file file_data.
# TEMPLATE_INGEST_OPENAI_MODE=responses_file
# Use chat_file only for gateways that support Chat Completions file parts.
# TEMPLATE_INGEST_OPENAI_MODE=chat_file
# Use chat_images for image-based OpenAI-format vision endpoints.
# TEMPLATE_INGEST_OPENAI_MODE=chat_images
# Use extracted only as a lower-fidelity fallback for text-only gateways.
# TEMPLATE_INGEST_OPENAI_MODE=extracted
# To use OpenAI directly, set OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# and OPENAI_COMPATIBLE_API_KEY to your OpenAI API key.
# To allow simple DOCX/HTML conversion without AI, with no PDF/layout reasoning:
# TEMPLATE_INGEST_PROVIDER=basic

# =============================================================================
# EMAIL - disabled
# =============================================================================

OUTBOUND_EMAIL_PROVIDER=none
INBOUND_EMAIL_PROVIDER=none
# With inbound email disabled, webhook/job routes are not mounted and the
# Settings page reports email ingest as unavailable by configuration.

# =============================================================================
# OPTIONAL - Processing and performance tuning
# =============================================================================

MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_LLM_REQUESTS=3
LOG_LEVEL=INFO
DEBUG_MODE=false

# =============================================================================
# FRONTEND COMPANION VALUES
# =============================================================================
#
# Put these in `frontend/.env.local` when running the browser app without
# Supabase. The access token entered on the login page must match
# LOCAL_AUTH_TOKEN above.
#
# VITE_AUTH_PROVIDER=local
# VITE_API_BASE_URL=http://localhost:8080
# VITE_LOCAL_AUTH_USER_ID=local-admin
# VITE_LOCAL_AUTH_EMAIL=local-admin@example.com
# VITE_LOCAL_AUTH_DISPLAY_NAME=Local Admin
#
# Optional development/internal prefill. Frontend VITE_ values are bundled into
# browser code, so this is not a secret.
# VITE_LOCAL_AUTH_TOKEN=replace-with-a-long-random-local-token
