# Attenly self-hosted Docker profile
#
# Recommended setup:
#   python scripts/init_self_hosted_env.py --llm-model replace-with-chat-model --embedding-model replace-with-embedding-model
#   # or, for Gemini:
#   python scripts/init_self_hosted_env.py --provider gemini --gemini-api-key replace-with-gemini-key --template-ingest-provider gemini
#   docker compose up -d --wait
#
# Manual setup:
# 1. Copy this file to .env.
# 2. Replace the LOCAL_AUTH_TOKEN and model names below.
# 3. Run: python scripts/check_self_hosted_env.py .env
# 4. Run: docker compose up -d --wait

# Docker images. During open-source preparation the published branch tag is
# open-sourcing. Versioned releases will replace this with an immutable tag.
ATTENLY_IMAGE_NAMESPACE=roblen001
ATTENLY_IMAGE_TAG=open-sourcing
ATTENLY_FRONTEND_PORT=5173

# Core application profile
ENV=production
PORT=8080
APP_PROFILE=local
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173/api
CORS_ORIGINS=http://localhost:5173

# Trusted single-user pilot authentication. Enter this token on the login page.
# Do not put it in a VITE_ variable; VITE_ values are visible in the browser.
AUTH_PROVIDER=local
LOCAL_AUTH_TOKEN=replace-with-a-long-random-token
LOCAL_AUTH_USER_ID=local-admin
LOCAL_AUTH_EMAIL=local-admin@example.com
LOCAL_AUTH_DISPLAY_NAME=Local Admin

# SQLite and documents both live in the attenly-data Docker volume.
DATABASE_PROVIDER=sqlalchemy
DATABASE_URL=sqlite:////data/attenly.db
DATABASE_AUTO_CREATE_TABLES=true
STORAGE_PROVIDER=filesystem
STORAGE_PATH=/data/storage

# Model endpoint. This default reaches Ollama or another OpenAI-compatible
# server running on the Docker host. Company gateways can use an HTTPS URL.
LLM_PROVIDER=openai_compatible
EMBEDDING_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1
# May be blank for a trusted local endpoint that does not require a key.
OPENAI_COMPATIBLE_API_KEY=
# Allow one difficult reasoning or multimodal request to run for five minutes.
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=300
LLM_MODEL=replace-with-chat-model
EMBEDDING_MODEL=replace-with-embedding-model
# Set this if the embedding endpoint does not return 1536-dimensional vectors.
EMBEDDING_DIMENSIONS=1536

# Uploaded smart-template interpretation is optional and disabled by default.
# Users can still create templates in the editor.
TEMPLATE_INGEST_PROVIDER=disabled

# Connectors are optional. The base install makes no email-provider requests.
OUTBOUND_EMAIL_PROVIDER=none
INBOUND_EMAIL_PROVIDER=none
# When inbound email is enabled, Compose runs queued email jobs in the
# email-worker service so the web backend stays responsive.
EMAIL_JOB_EXECUTION_MODE=worker
EMAIL_WORKER_POLL_INTERVAL_SECONDS=30
EMAIL_WORKER_MAX_JOBS_PER_CYCLE=1

# The Docker frontend bundles TinyMCE and proxies /api to the backend.
VITE_TINYMCE_MODE=self_hosted
VITE_TINYMCE_SCRIPT_SRC=/tinymce/tinymce.min.js
VITE_TINYMCE_LICENSE_KEY=gpl

# Conservative defaults for a single-machine pilot.
DEFAULT_MONTHLY_LIMIT_CAD=15.00
DEFAULT_MODEL_INPUT_COST_PER_MILLION_CAD=0
DEFAULT_MODEL_OUTPUT_COST_PER_MILLION_CAD=0
MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500
MAX_CONCURRENT_UPLOADS=2
MAX_CONCURRENT_LLM_REQUESTS=3
LOG_LEVEL=INFO
DEBUG_MODE=false
