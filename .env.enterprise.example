# Attenly Enterprise Profile
# Planned target profile for provider-interface work.
# This file documents the intended configuration for companies that want to
# replace the default Supabase/Gemini/Resend stack with internal services.
#
# NOTE: The backend now supports local bearer-token auth, SQLAlchemy/SQLite,
# filesystem storage, disabled email, Microsoft Graph outbound email, and
# Microsoft Graph inbound polling. The frontend supports local token login, and
# document extraction can use OpenAI-compatible chat and embedding endpoints.
# Full browser OIDC redirect login is still planned adapter work.

# =============================================================================
# CORE APP
# =============================================================================

ENV=production
PORT=8080
APP_PROFILE=enterprise
APP_URL=https://attenly.company.internal
PUBLIC_API_URL=https://attenly.company.internal/api
CORS_ORIGINS=https://attenly.company.internal
APP_SECRET_KEY=replace-with-a-long-random-secret

# =============================================================================
# DATABASE - SQLite through SQLAlchemy for pilots
# =============================================================================

DATABASE_PROVIDER=sqlalchemy
DATABASE_URL=sqlite:////data/attenly.db

# For production, move to a managed SQL database when ready:
# DATABASE_URL=postgresql://attenly:replace-with-password@postgres.company.internal:5432/attenly

# =============================================================================
# STORAGE - local filesystem volume for pilots
# =============================================================================

STORAGE_PROVIDER=filesystem
STORAGE_PATH=/data/storage

# =============================================================================
# AUTH - local first, external JWT when using an IdP or gateway
# =============================================================================

AUTH_PROVIDER=local
LOCAL_AUTH_TOKEN=replace-with-a-long-random-internal-token
LOCAL_AUTH_USER_ID=enterprise-admin
LOCAL_AUTH_EMAIL=attenly-admin@company.com
LOCAL_AUTH_DISPLAY_NAME=Attenly Admin

# To trust bearer tokens issued by your IdP, API gateway, or SSO proxy:
# AUTH_PROVIDER=external_jwt
#
# Simple HMAC gateway tokens:
# EXTERNAL_JWT_SECRET=replace-with-shared-jwt-verification-secret
# EXTERNAL_JWT_ALGORITHM=HS256
#
# OIDC/IdP tokens signed with asymmetric keys:
# EXTERNAL_JWT_JWKS_URL=https://login.company.internal/.well-known/jwks.json
# EXTERNAL_JWT_ALGORITHM=RS256
#
# Recommended for production:
# EXTERNAL_JWT_ISSUER=https://login.company.internal
# EXTERNAL_JWT_AUDIENCE=attenly
# EXTERNAL_JWT_USER_ID_CLAIM=sub
# EXTERNAL_JWT_EMAIL_CLAIM=email
# EXTERNAL_JWT_NAME_CLAIM=name
# EXTERNAL_JWT_REQUIRE_EXP=true
#
# Future full browser OIDC login example:
# AUTH_PROVIDER=oidc
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://attenly.company.internal/auth/callback

# =============================================================================
# AI - on-prem OpenAI-compatible model endpoint
# =============================================================================

LLM_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=https://models.company.internal/v1
# Leave blank only if your internal gateway does not require authentication.
OPENAI_COMPATIBLE_API_KEY=replace-with-internal-model-token
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=300
LLM_MODEL=company-document-model

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=company-embedding-model
# Set this when your embedding model does not return 1536-dimensional vectors.
# EMBEDDING_DIMENSIONS=1536

# Uploaded template ingestion is separate from normal report extraction. It is
# a hard layout/multimodal task, so complex DOCX/PDF templates need a smart
# multimodal provider. Leave disabled when users will build templates in-app.
TEMPLATE_INGEST_PROVIDER=disabled
# To allow simple DOCX/HTML conversion without AI, with no PDF/layout reasoning:
# TEMPLATE_INGEST_PROVIDER=basic
# To use your OpenAI-compatible endpoint for smart template ingestion:
# TEMPLATE_INGEST_PROVIDER=openai_compatible
# TEMPLATE_INGEST_MODEL=company-template-model
# The configured endpoint/model must support multimodal file or image input.
# To use OpenAI directly, set OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# and OPENAI_COMPATIBLE_API_KEY to your OpenAI API key.
# Gemini is also supported as a smart provider:
# TEMPLATE_INGEST_PROVIDER=gemini
# TEMPLATE_INGEST_MODEL_NAME=gemini-3.5-flash

# =============================================================================
# EMAIL - disabled by default, Microsoft Graph optional
# =============================================================================

OUTBOUND_EMAIL_PROVIDER=none
INBOUND_EMAIL_PROVIDER=none

# With inbound email disabled, webhook/job routes are not mounted and the
# Settings page reports email ingest as unavailable by configuration. With
# outbound email disabled, report links are not emailed automatically.
#
# To enable Microsoft Graph outbound email:
# OUTBOUND_EMAIL_PROVIDER=microsoft_graph
# GRAPH_TENANT_ID=your-tenant-id
# GRAPH_CLIENT_ID=your-client-id
# GRAPH_CLIENT_SECRET=your-client-secret
# GRAPH_MAILBOX=attenly@company.com

# To enable Microsoft Graph inbound polling:
# INBOUND_EMAIL_PROVIDER=microsoft_graph
# GRAPH_TENANT_ID=your-tenant-id
# GRAPH_CLIENT_ID=your-client-id
# GRAPH_CLIENT_SECRET=your-client-secret
# GRAPH_MAILBOX=attenly@company.com
# INTERNAL_CRON_SECRET=generate-a-long-random-secret
# GRAPH_POLL_BATCH_SIZE=10
# GRAPH_POLL_LOOKBACK_SECONDS=300
# Compose runs the email-worker service automatically. It polls Graph, creates
# email jobs, then processes queued jobs outside the web backend.
EMAIL_JOB_EXECUTION_MODE=worker
EMAIL_WORKER_POLL_INTERVAL_SECONDS=30
EMAIL_WORKER_MAX_JOBS_PER_CYCLE=1
# Optional manual nudge:
# POST /internal/process-email-jobs with X-Cron-Secret.

# =============================================================================
# OPTIONAL - Processing and performance tuning
# =============================================================================

DEFAULT_MONTHLY_LIMIT_CAD=15.00
# Unknown/internal model costs use these defaults for usage-limit accounting.
# Set both to 0 if your local gateway has no chargeback cost.
DEFAULT_MODEL_INPUT_COST_PER_MILLION_CAD=0.10
DEFAULT_MODEL_OUTPUT_COST_PER_MILLION_CAD=0.40
# SQLite pilots auto-create SQLAlchemy tables by default. Disable this when
# your company manages schema creation separately.
DATABASE_AUTO_CREATE_TABLES=true
MAX_FILE_SIZE_MB=50
PDF_MAX_PAGES=500
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_LLM_REQUESTS=3
LOG_LEVEL=INFO
DEBUG_MODE=false

# =============================================================================
# FRONTEND COMPANION VALUES
# =============================================================================
#
# Put these in `frontend/.env.local` for a no-Supabase frontend pilot. Users can
# enter LOCAL_AUTH_TOKEN, or an externally issued JWT when
# VITE_AUTH_PROVIDER=external_jwt, at login. The optional prefill below is
# visible in the browser bundle and should not be treated as a secret.
#
# VITE_AUTH_PROVIDER=local
# # Or:
# VITE_AUTH_PROVIDER=external_jwt
# VITE_API_BASE_URL=https://attenly-api.company.internal
# VITE_LOCAL_AUTH_USER_ID=enterprise-admin
# VITE_LOCAL_AUTH_EMAIL=attenly-admin@company.com
# VITE_LOCAL_AUTH_DISPLAY_NAME=Attenly Admin
# VITE_LOCAL_AUTH_TOKEN=replace-with-a-long-random-internal-token
#
# The open-source Docker frontend self-hosts TinyMCE by default, so no Tiny
# Cloud API key is required for the rich text editor. Use your commercial
# self-host license key instead of `gpl` when applicable.
VITE_TINYMCE_MODE=self_hosted
VITE_TINYMCE_SCRIPT_SRC=/tinymce/tinymce.min.js
VITE_TINYMCE_LICENSE_KEY=gpl
# Only set this when VITE_TINYMCE_MODE=cloud.
# VITE_TINYMCE_API_KEY=
